VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN testcase ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 100000 200000 ) ;
NETS 1 ;
- VDD + USE POWER
  + ROUTED Metal4 ( 0 11000 ) ( 100000 * )
  + ROUTED Metal5 ( 0 15000 ) ( 100000 * )
  ;
END NETS

SPECIALNETS 4 ;
- VSS + USE GROUND
  + ROUTED Metal4 1000 ( 0 21000 ) ( 100000 * )
  + ROUTED Metal5 1000 ( 0 25000 ) ( 100000 * )
  ;
- VDD2 + USE POWER
  + FIXED Metal4 600 ( 0 41000 ) ( 100000 * )
  + FIXED Metal5 600 ( 0 45000 ) ( 100000 * )
  ;
- VSS2 + USE GROUND
  + COVER Metal4 800 ( 0 61000 ) ( 100000 * )
  + ROUTED Metal5 800 ( 0 65000 ) ( 100000 * )
    NEW Metal4 800 ( 0 69000 ) ( 100000 * )
  ;
- VSS3 + USE GROUND
  + ROUTED Metal5 400 ( 0 85000 ) ( 100000 * )
  + SHIELD VDD Metal4 400 ( 0 81000 ) ( 100000 * )
  ;
END SPECIALNETS
END DESIGN
